<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NuciNotifications.API.ArchitectureTests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ExcludeFromCodeCoverage>true</ExcludeFromCodeCoverage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" Version="0.13.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NuciNotifications.API/NuciNotifications.API.csproj" />
    <None Include="../NuciNotifications.API/NuciNotifications.API.csproj"
          Link="ProductionProjects/NuciNotifications.API.csproj"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>