{
  "securitySettings": {
    "apiKey": "[[NUCINOTIFICATIONS_API_KEY]]"
  },
  "smtpSettings": {
    "host": "[[SMTP_HOST]]",
    "port": "[[SMTP_PORT]]",
    "username": "[[SMTP_USERNAME]]",
    "password": "[[SMTP_PASSWORD]]",
    "senderName": "Notifier",
